{
  "policies": {
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DontCheckDefaultBrowser": true,
    "EnableTrackingProtection": {
      "Value": true,
      "Locked": false,
      "Cryptomining": true,
      "Fingerprinting": true
    },
    "EncryptedMediaExtensions": {
      "Enabled": true,
      "Locked": false
    },
    "FirefoxHome": {
      "SponsoredTopSites": false,
      "SponsoredPocket": false
    },
    "SearchEngines": {
      "Add": [
        {
          "Name": "Noliae",
          "URLTemplate": "https://noliae.com/search?q={searchTerms}",
          "Method": "GET",
          "IconURL": "https://noliae.com/favicon.ico",
          "Alias": "@noliae",
          "Description": "Moteur de recherche Noliae"
        }
      ],
      "Default": "Noliae",
      "Remove": ["Google", "Bing"]
    },
    "Homepage": {
      "URL": "https://noliae.com",
      "StartPage": "homepage"
    },
    "Bookmarks": [
      {
        "Title": "Noliae IA",
        "URL": "https://ia.noliae.com",
        "Placement": "toolbar"
      },
      {
        "Title": "Recherche Noliae",
        "URL": "https://noliae.com",
        "Placement": "toolbar"
      }
    ]
  }
}
