# Outil NolFox : extrait la version Firefox ESR courante depuis le JSON
# product-details de Mozilla (télécharge par scripts/fetch.sh).
# Usage : nolc run outils/version_esr.nol -- product_details.json

fn extrait(json: Text, cle: Text) -> Option<Text> {
    let motif = "\"" + cle + "\":"
    let pos_o = find(json, motif)
    if not has(pos_o) { return none }
    let debut = unwrap_or(pos_o, 0) + len(motif)
    let reste = sub(json, debut, len(json) - debut)
    let q1_o = find(reste, "\"")
    if not has(q1_o) { return none }
    let q1 = unwrap_or(q1_o, 0)
    let corps = sub(reste, q1 + 1, len(reste) - q1 - 1)
    let q2_o = find(corps, "\"")
    if not has(q2_o) { return none }
    return some(sub(corps, 0, unwrap_or(q2_o, 0)))
}

fn main() {
    let a = args()
    if len(a) < 1 {
        print("usage: version_esr <product_details.json>")
        return
    }
    let contenu_o = file_read(get(a, 0))
    if not has(contenu_o) {
        print("erreur: fichier illisible")
        return
    }
    let contenu = unwrap_or(contenu_o, "")
    let v_o = extrait(contenu, "FIREFOX_ESR")
    if not has(v_o) {
        print("erreur: clé FIREFOX_ESR introuvable")
        return
    }
    var version = unwrap_or(v_o, "")
    # la valeur upstream est de la forme "140.1.0esr" : on retire le suffixe
    let p_esr = find(version, "esr")
    if has(p_esr) {
        version = sub(version, 0, unwrap_or(p_esr, 0))
    }
    if not file_write("VERSION_ESR", version) {
        print("erreur: écriture VERSION_ESR impossible")
        return
    }
    print(version)
}
